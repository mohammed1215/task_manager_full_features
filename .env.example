# Database Configuration
DB_HOST=your-postgres-host.vercel-storage.com
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_database_name

DB_PASSWORD="123123"
DB_USER="postgres"
DB_NAME="task_manager_full"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=3600
JWT_REFRESH_SECRET=your_jwt_refresh_key
RESET_SECRET_PASS=your_jwt_reset_secret_key
VERIFICATION_SECRET_KEY=your_jwt_verification_secret_key

# Node Environment
NODE_ENV=production

# Email Configuration (if using nodemailer)
MAIL_SERVICE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# URLS
BACKEND_URL=https://your-backend-domain.com/api/v1
FRONTEND_URL=https://your-frontend-domain.com

# Optional: API Port (Vercel will auto-assign)
PORT=3001


CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret