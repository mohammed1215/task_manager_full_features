<html>
    <head>
        <meta charset='UTF-8' />
        <title>Password Reset Confirmation</title>
        <style>
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                background: #f5f7fb;
                color: #333;
            }
            .container {
                max-width: 600px;
                margin: 40px auto;
                background: #ffffff;
                padding: 24px;
                border-radius: 10px;
                box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            }
            .header {
                font-size: 22px;
                font-weight: 700;
                margin-bottom: 16px;
            }
            .message {
                font-size: 16px;
                line-height: 1.6;
                margin-bottom: 24px;
            }
            .button {
                display: inline-block;
                padding: 12px 20px;
                background: #007bff;
                color: #ffffff;
                text-decoration: none;
                border-radius: 6px;
            }
            .footer {
                margin-top: 24px;
                font-size: 13px;
                color: #777;
            }
        </style>
    </head>
    <body>
        <div class='container'>
            <div class='header'>Password Reset Confirmed</div>
            <div class='message'>
                Hello
                {{name}},
                <br /><br />
                Your password has been changed successfully.
                <br /><br />
                If you didn’t change your password, please reset your password
                again immediately.
            </div>
            {{#if resetLink}}
                <a class='button' href='{{resetLink}}'>Reset Password Again</a>
            {{/if}}
            <div class='footer'>
                If you need help, reply to this email or contact support.
                <br />
                {{appName}}
                Team
            </div>

        </div>
    </body>
</html>