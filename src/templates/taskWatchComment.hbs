<html lang='en'>
    <head>
        <meta charset='UTF-8' />
        <meta name='viewport' content='width=device-width, initial-scale=1.0' />
        <title>Task Comment Notification</title>
        <style>
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                background-color: #f4f4f7;
                color: #333333;
            }
            .container {
                width: 100%;
                max-width: 600px;
                margin: 0 auto;
                padding: 24px;
                background-color: #ffffff;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            }
            .header {
                margin-bottom: 24px;
                border-bottom: 3px solid #17a2b8;
                padding-bottom: 16px;
            }
            .header h2 {
                margin: 0;
                color: #17a2b8;
                font-size: 24px;
            }
            .content {
                margin: 24px 0;
                line-height: 1.6;
            }
            .highlight {
                background-color: #d1ecf1;
                padding: 12px;
                border-left: 4px solid #17a2b8;
                margin: 16px 0;
                border-radius: 4px;
            }
            .footer {
                margin-top: 24px;
                padding-top: 16px;
                border-top: 1px solid #e0e0e0;
                font-size: 12px;
                color: #999999;
            }
        </style>
    </head>
    <body>
        <div class='container'>
            <div class='header'>
                <h2>New Comment on Watched Task</h2>
            </div>
            <div class='content'>
                <p>Hello,</p>
                <p>There's been activity on a task you're watching.</p>
                <div class='highlight'>
                    <strong>💬 A new comment has been added to a task</strong>
                </div>
                <p>Visit your Task Manager account to read the comment and
                    continue the discussion with your team.</p>
            </div>
            <div class='footer'>
                <p>Best regards,<br />Task Manager Team</p>
            </div>
        </div>
    </body>
</html>